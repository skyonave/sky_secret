get_target_property(runner_sources ${BINARY_NAME} SOURCES)
get_target_property(runner_directory ${BINARY_NAME} SOURCE_DIR)
set(integration_sources)
foreach(source IN LISTS runner_sources)
  if(source MATCHES "(^|/)main[.]cpp$")
    continue()
  endif()
  if(IS_ABSOLUTE "${source}")
    list(APPEND integration_sources "${source}")
  else()
    list(APPEND integration_sources "${runner_directory}/${source}")
  endif()
endforeach()
add_executable(startup_indicator_integration EXCLUDE_FROM_ALL
  "${CMAKE_CURRENT_SOURCE_DIR}/../integration_test/windows/startup_indicator_test.cpp"
  ${integration_sources})
apply_standard_settings(startup_indicator_integration)
foreach(property INCLUDE_DIRECTORIES COMPILE_DEFINITIONS LINK_LIBRARIES)
  get_target_property(value ${BINARY_NAME} ${property})
  set_property(TARGET startup_indicator_integration PROPERTY ${property} "${value}")
endforeach()
target_include_directories(startup_indicator_integration PRIVATE "${runner_directory}")
set_target_properties(startup_indicator_integration PROPERTIES
  RUNTIME_OUTPUT_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/runner")
