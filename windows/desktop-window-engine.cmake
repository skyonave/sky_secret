function(skysecret_configure_companion_engine)
  set(plugin desktop_multi_window_plugin)
  get_target_property(plugin_directory ${plugin} SOURCE_DIR)
  set(original "${plugin_directory}/flutter_window.cc")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${original}")
  file(READ "${original}" source)
  set(project "  flutter::DartProject project(L\"data\");")
  string(FIND "${source}" "${project}" project_offset)
  if(project_offset EQUAL -1)
    message(FATAL_ERROR "desktop_multi_window project setup changed; review renderer selection")
  endif()
  string(REPLACE "${project}" "${project}\n  project.set_impeller_switch(flutter::ImpellerSwitch::Enabled);" source "${source}")
  if(NOT source MATCHES "set_ui_thread_policy")
    string(REPLACE "${project}" "${project}\n  project.set_ui_thread_policy(flutter::UIThreadPolicy::RunOnSeparateThread);" source "${source}")
  endif()
  string(REPLACE "      flutter_controller_->engine()->ReloadSystemFonts();" "      if (flutter_controller_) flutter_controller_->engine()->ReloadSystemFonts();" source "${source}")
  set(patched_directory "${CMAKE_CURRENT_BINARY_DIR}/desktop-window-engine")
  file(MAKE_DIRECTORY "${patched_directory}")
  set(patched "${patched_directory}/flutter_window.cc")
  file(WRITE "${patched}" "${source}")
  get_target_property(sources ${plugin} SOURCES)
  list(FILTER sources EXCLUDE REGEX "(^|/)flutter_window[.]cc$")
  list(APPEND sources "${patched}")
  set_property(TARGET ${plugin} PROPERTY SOURCES "${sources}")
  target_include_directories(${plugin} PRIVATE "${plugin_directory}")
endfunction()

skysecret_configure_companion_engine()

